<?xml version="1.0" encoding="utf-8"?>
<!--
  eidos-setup.exe: the guided installer.

  The bundle owns the user experience (installer\Eidos.Setup.Ui) and drives
  eidos.msi, a dual-scope package: the UI decides per-user or per-machine and
  passes every choice through the variables below. The same variables are
  overridable from the command line for unattended installs:

    eidos-setup.exe /quiet EIDOS_SCOPE=perMachine EIDOS_PORT=7700
    eidos-setup.exe /quiet /uninstall EIDOS_REMOVE_DATA=1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Id="Eidos.Indexer.Setup"
          Name="eidos"
          Manufacturer="eidos"
          Version="$(var.Version)"
          IconSourceFile="..\Eidos.Msi\eidos.ico"
          AboutUrl="https://github.com/josiah-nelson/eidos"
          HelpUrl="https://github.com/josiah-nelson/eidos/blob/main/docs/overview.md"
          Condition="VersionNT64"
          Compressed="yes"
          DisableModify="no">

    <bal:Condition Condition="VersionNT64" Message="eidos requires 64-bit Windows 10 or later." />
    <util:RegistrySearchRef Id="NETFRAMEWORK45" />

    <!-- Choices made in the UI, or given on the command line for /quiet. -->
    <Variable Name="EIDOS_SCOPE" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_INSTALLDIR" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_DATADIR" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_BIND" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_PORT" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_SERVICE_ACCOUNT_KIND" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_SERVICE_DOMAIN" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_SERVICE_USER" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_SERVICE_PASSWORD" Value="" Hidden="yes" bal:Overridable="yes" />
    <Variable Name="EIDOS_START_SERVICE" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_START_MENU" Value="" bal:Overridable="yes" />
    <Variable Name="EIDOS_REMOVE_DATA" Value="" bal:Overridable="yes" />

    <BootstrapperApplication SourceFile="$(var.BaDir)\eidos-setup-ui.exe">
      <Payload SourceFile="$(var.BaDir)\eidos-setup-ui.exe.config" />
      <Payload SourceFile="$(var.BaDir)\WixToolset.BootstrapperApplicationApi.dll" />
      <Payload SourceFile="$(var.BaDir)\mbanative.dll" />
      <!-- Runs only if the UI cannot start (no .NET Framework 4.7.2): installs it, then retries. -->
      <bal:WixPrerequisiteBootstrapperApplication />
    </BootstrapperApplication>

    <Chain>
      <!--
        .NET Framework 4.7.2 for the setup UI, installed by the prerequisite
        BA only when missing (Windows 10 1803+ / Server 2019+ ship it). This
        is WixToolset.Netfx.wixext's NetFx472Web package with Cache="keep":
        the library's Cache="remove" makes the engine try to clean a
        per-machine cache from a per-user install, which logs an error.
      -->
      <ExePackage Id="NetFx472Web"
                  CacheId="NetFx472Web_ABDCA79AF9DD48A0EA702AD45260B3C03093FB4B"
                  InstallArguments="/q /norestart /log &quot;[NetFx472WebLog].html&quot;"
                  PerMachine="yes" Permanent="yes" Vital="yes" Protocol="netfx4" Cache="keep"
                  LogPathVariable="NetFx472WebLog"
                  DetectCondition="NETFRAMEWORK45 &gt;= 461808"
                  bal:PrereqPackage="yes" bal:PrereqLicenseUrl="https://referencesource.microsoft.com/license.html">
        <ExePackagePayload Name="redist\NDP472-KB4054531-Web.exe"
                           DownloadUrl="https://go.microsoft.com/fwlink/?LinkId=863262"
                           ProductName="Microsoft .NET Framework 4.7.2"
                           Description="Microsoft .NET Framework 4.7.2 Setup"
                           CertificatePublicKey="F49F9B33E25E33CCA0BFB15A62B7C29FFAB3880B"
                           CertificateThumbprint="ABDCA79AF9DD48A0EA702AD45260B3C03093FB4B"
                           Size="1405792" Version="4.7.3081.0" />
      </ExePackage>

      <MsiPackage Id="EidosMsi" SourceFile="$(var.MsiPath)" Vital="yes" Compressed="yes" Visible="no">
        <MsiProperty Name="EIDOS_INSTALLDIR" Value="[EIDOS_INSTALLDIR]" Condition="EIDOS_INSTALLDIR" />
        <MsiProperty Name="EIDOS_DATADIR" Value="[EIDOS_DATADIR]" Condition="EIDOS_DATADIR" />
        <MsiProperty Name="EIDOS_BIND" Value="[EIDOS_BIND]" Condition="EIDOS_BIND" />
        <MsiProperty Name="EIDOS_PORT" Value="[EIDOS_PORT]" Condition="EIDOS_PORT" />
        <MsiProperty Name="EIDOS_SERVICE_ACCOUNT_KIND" Value="[EIDOS_SERVICE_ACCOUNT_KIND]" Condition="EIDOS_SERVICE_ACCOUNT_KIND" />
        <MsiProperty Name="EIDOS_SERVICE_DOMAIN" Value="[EIDOS_SERVICE_DOMAIN]" Condition="EIDOS_SERVICE_DOMAIN" />
        <MsiProperty Name="EIDOS_SERVICE_USER" Value="[EIDOS_SERVICE_USER]" Condition="EIDOS_SERVICE_USER" />
        <MsiProperty Name="EIDOS_SERVICE_PASSWORD" Value="[EIDOS_SERVICE_PASSWORD]" Condition="EIDOS_SERVICE_PASSWORD" />
        <MsiProperty Name="EIDOS_START_SERVICE" Value="[EIDOS_START_SERVICE]" Condition="EIDOS_START_SERVICE" />
        <MsiProperty Name="EIDOS_START_MENU" Value="[EIDOS_START_MENU]" Condition="EIDOS_START_MENU" />
        <MsiProperty Name="EIDOS_REMOVE_DATA" Value="[EIDOS_REMOVE_DATA]" Condition="EIDOS_REMOVE_DATA" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
