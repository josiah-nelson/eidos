<Window x:Class="Eidos.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Eidos.Setup"
        Title="{Binding Title}"
        Width="760" Height="560" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="#FFFFFFFF"
        Closing="OnClosing">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#863BFF" />
    <SolidColorBrush x:Key="Ink" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Muted" Color="#5F5F5F" />
    <SolidColorBrush x:Key="Warn" Color="#9A3B00" />
    <SolidColorBrush x:Key="Error" Color="#B00020" />
    <SolidColorBrush x:Key="Ok" Color="#0F7B3F" />
    <SolidColorBrush x:Key="Rule" Color="#E6E6E6" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,12,0,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="24,2,0,8" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6F2BD8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#C9B8EC" />
                <Setter Property="BorderBrush" Value="#C9B8EC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <BooleanToVisibilityConverter x:Key="Vis" />

    <!-- ===== pages ===== -->

    <DataTemplate x:Key="Loading">
      <StackPanel VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Height="6" Width="320" HorizontalAlignment="Left" />
        <TextBlock Style="{StaticResource Sub}" Text="Looking for an existing installation…" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Welcome">
      <StackPanel>
        <TextBlock Margin="0,8,0,0">
          eidos indexes local drives and network shares into one searchable catalog with full-text search over file contents, live change tracking, and a web interface on this computer.
        </TextBlock>
        <TextBlock Margin="0,12,0,0">
          Everything eidos reads is opened read-only; it never writes to the folders it indexes.
        </TextBlock>
        <TextBlock Margin="0,20,0,0">
          <Run Text="eidos is free software under the " /><Hyperlink Command="{Binding OpenLicenseCommand}">GNU AGPL v3</Hyperlink><Run Text=". Continuing means you accept its terms." />
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Scope">
      <StackPanel>
        <RadioButton GroupName="scope" IsChecked="{Binding PerUser}" Content="Just me" />
        <TextBlock Style="{StaticResource Hint}">
          No administrator rights needed. Installs under your profile, indexes what you can open, and runs while you are signed in.
        </TextBlock>
        <RadioButton GroupName="scope" IsChecked="{Binding PerMachine}" Content="All users on this computer (Windows service)" />
        <TextBlock Style="{StaticResource Hint}">
          Installs to Program Files and runs as a Windows service that starts with the computer, keeps indexing while nobody is signed in, and is available to every user.
        </TextBlock>
        <TextBlock Foreground="{StaticResource Warn}" Margin="0,16,0,0" Text="{Binding ElevationNote}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Location">
      <StackPanel>
        <TextBlock Style="{StaticResource Label}" Text="Program folder" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Browse…" Command="{Binding BrowseInstallDirCommand}" />
          <TextBox Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Style="{StaticResource Label}" Text="Data folder (catalog, indexes, logs)" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Browse…" Command="{Binding BrowseDataDirCommand}" />
          <TextBox Text="{Binding DataDir, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Style="{StaticResource Label}" Text="Port for the web interface" />
        <StackPanel Orientation="Horizontal">
          <TextBox Width="90" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}">
            <Run Text="eidos will open at " /><Run Text="{Binding Url, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" " /><Run Text="{Binding UrlNote, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <Expander Header="Advanced: listen address" Margin="0,16,0,0" FontSize="13" Foreground="{StaticResource Ink}" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="20,8,0,0" HorizontalAlignment="Stretch">
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
              127.0.0.1 keeps eidos reachable only from this computer. 0.0.0.0 answers on every network adapter; a specific address answers on that adapter only.
            </TextBlock>
            <ComboBox Width="220" HorizontalAlignment="Left" Margin="0,8,0,0" IsEditable="True" ItemsSource="{Binding BindChoices}" Text="{Binding Bind, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Foreground="{StaticResource Warn}" Margin="0,8,0,0" Text="{Binding BindWarning}" />
          </StackPanel>
        </Expander>
        <TextBlock Foreground="{StaticResource Error}" Margin="0,16,0,0" Text="{Binding Validation}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Account">
      <StackPanel>
        <RadioButton GroupName="acct" IsChecked="{Binding IsLocalSystem}" Content="The system account (local disks only)" />
        <RadioButton GroupName="acct" IsChecked="{Binding IsUserAccount}" Content="A Windows account (needed for network shares)" />
        <Grid Margin="24,8,0,0" IsEnabled="{Binding IsUserAccount}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6" Text="Account" />
          <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding AccountUser, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Password" />
          <PasswordBox Grid.Row="1" Grid.Column="1" PasswordChanged="OnPasswordChanged" />
          <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Small}" Content="Verify" Command="{Binding VerifyAccountCommand}" />
        </Grid>
        <TextBlock Margin="24,6,0,0" Text="{Binding AccountStatus}" Foreground="{StaticResource Muted}" />
        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
          <TextBlock Foreground="{StaticResource Muted}" Text="{Binding AccountExplanation}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Options">
      <StackPanel>
        <Border Background="#F6F3FC" CornerRadius="4" Padding="14,10">
          <TextBlock FontFamily="Consolas" FontSize="12.5" Text="{Binding SummaryText}" />
        </Border>
        <CheckBox IsChecked="{Binding StartService}" Content="Start the service now and whenever Windows starts" Visibility="{Binding PerMachine, Converter={StaticResource Vis}}" />
        <CheckBox IsChecked="{Binding StartMenu}" Content="Add eidos to the Start menu" />
        <CheckBox IsChecked="{Binding LaunchAfter}" Content="Open eidos in the browser when setup finishes" />
        <TextBlock Foreground="{StaticResource Warn}" Margin="0,16,0,0" Text="{Binding ElevationNote}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Progress">
      <StackPanel VerticalAlignment="Center">
        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource Accent}" />
        <TextBlock Style="{StaticResource Sub}" Text="{Binding ProgressMessage}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Success">
      <StackPanel>
        <TextBlock Text="{Binding SuccessText}" />
        <TextBlock Margin="0,12,0,0" Visibility="{Binding RestartRequired, Converter={StaticResource Vis}}" Foreground="{StaticResource Warn}"
                   Text="Windows needs to restart to finish; the service starts after the restart." />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Failure">
      <StackPanel>
        <TextBlock Foreground="{StaticResource Error}" Text="{Binding ErrorMessage}" />
        <TextBlock Margin="0,16,0,0">
          <Hyperlink Command="{Binding OpenLogCommand}">Open the setup log</Hyperlink>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Maintenance">
      <StackPanel>
        <TextBlock Foreground="{StaticResource Muted}">
          <Run Text="Installed " /><Run Text="{Binding DetectedScopeText, Mode=OneWay}" /><Run Text=" in " /><Run Text="{Binding InstallDir, Mode=OneWay}" />
        </TextBlock>
        <RadioButton GroupName="maint" IsChecked="{Binding Repair}" Content="Repair" />
        <TextBlock Style="{StaticResource Hint}" Text="Reinstall the program files and the service registration. Settings and data are untouched." />
        <RadioButton GroupName="maint" IsChecked="{Binding Uninstall}" Content="Remove" />
        <TextBlock Style="{StaticResource Hint}" Text="Uninstall eidos from this computer." />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Remove">
      <StackPanel>
        <CheckBox IsChecked="{Binding RemoveData}" Content="{Binding RemoveDataLabel}" />
        <TextBlock Style="{StaticResource Hint}" Text="Deleting the data removes the catalog and search indexes. The files that were indexed are never touched." />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Blocked">
      <TextBlock Text="A newer version of eidos is installed on this computer. Remove it from Settings › Apps first if you want to install this version." />
    </DataTemplate>

    <Style x:Key="PageHost" TargetType="ContentControl">
      <Setter Property="Content" Value="{Binding}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Page}" Value="Loading"><Setter Property="ContentTemplate" Value="{StaticResource Loading}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Welcome"><Setter Property="ContentTemplate" Value="{StaticResource Welcome}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Scope"><Setter Property="ContentTemplate" Value="{StaticResource Scope}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Location"><Setter Property="ContentTemplate" Value="{StaticResource Location}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Account"><Setter Property="ContentTemplate" Value="{StaticResource Account}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Options"><Setter Property="ContentTemplate" Value="{StaticResource Options}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Progress"><Setter Property="ContentTemplate" Value="{StaticResource Progress}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Success"><Setter Property="ContentTemplate" Value="{StaticResource Success}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Failure"><Setter Property="ContentTemplate" Value="{StaticResource Failure}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Maintenance"><Setter Property="ContentTemplate" Value="{StaticResource Maintenance}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Remove"><Setter Property="ContentTemplate" Value="{StaticResource Remove}" /></DataTrigger>
        <DataTrigger Binding="{Binding Page}" Value="Blocked"><Setter Property="ContentTemplate" Value="{StaticResource Blocked}" /></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Padding="32,28,32,18" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding PageTitle}" />
        <TextBlock Style="{StaticResource Sub}" Text="{Binding PageSubtitle}" />
      </StackPanel>
    </Border>

    <!-- page -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,16,32,16">
      <ContentControl Style="{StaticResource PageHost}" Focusable="False" />
    </ScrollViewer>

    <!-- footer -->
    <Border Grid.Row="2" Padding="32,14" Background="#FAFAFA" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12">
          <Run Text="eidos " /><Run Text="{Binding Version, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Back" Command="{Binding BackCommand}" Visibility="{Binding ShowBack, Converter={StaticResource Vis}}" />
          <Button Style="{StaticResource Primary}" Content="{Binding PrimaryLabel}" Command="{Binding NextCommand}" IsDefault="True" Visibility="{Binding ShowPrimary, Converter={StaticResource Vis}}" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="False">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SecondaryLabel}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
