#!/usr/bin/env sh
# Run the full local check before a push.
#
# The per-commit CI gate lints Windows but does not test it (see
# docs/adr/0019), so on a Windows machine this hook is the only automated
# check that runs the suite on Windows before code lands. That is the whole
# reason it exists; skipping it routinely puts the burden on the nightly.
#
# Install once, from the repository root:
#
#     git config core.hooksPath scripts/hooks
#
# Bypass a single push with `git push --no-verify` when you mean to.

set -eu

zero='0000000000000000000000000000000000000000'
range=''
deleting_only=1

# stdin carries: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # deleting a remote ref
    deleting_only=0
    if [ "$remote_sha" = "$zero" ]; then
        # New branch: diff against main where they last agreed, so a fresh
        # branch checks its own commits and not the whole history.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
        [ -n "$base" ] && range="$base $local_sha" || range=''
    else
        range="$remote_sha $local_sha"
    fi
    # Anything we cannot scope, we check in full rather than skip.
    [ -z "$range" ] && break
done

[ "$deleting_only" = 1 ] && exit 0

# A push that touches no Rust is not worth a Rust build. Docs-only pushes are
# common here and CI still covers the web lane.
if [ -n "$range" ]; then
    # shellcheck disable=SC2086
    changed=$(git diff --name-only $range -- crates Cargo.toml Cargo.lock .cargo 2>/dev/null || true)
    if [ -z "$changed" ]; then
        echo "pre-push: no Rust changes in this push; skipping the suite."
        exit 0
    fi
fi

echo "pre-push: running the full local check (git push --no-verify to skip)."

# The web build and the release build are covered by CI and by the release
# workflow; this hook exists for the Rust suite on this platform.
case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW* | MSYS* | CYGWIN* | Windows_NT | unknown)
        if command -v pwsh >/dev/null 2>&1; then
            shell=pwsh
        elif command -v powershell >/dev/null 2>&1; then
            shell=powershell
        else
            echo "pre-push: no PowerShell found to run scripts/check.ps1" >&2
            exit 1
        fi
        "$shell" -NoProfile -NonInteractive -File scripts/check.ps1 -SkipWeb -SkipRelease
        ;;
    *)
        exec scripts/check.sh --skip-web --skip-release
        ;;
esac
